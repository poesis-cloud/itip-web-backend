# Default environment variables for dev/runtime wiring.
# Non-secret defaults are checked in. Override secrets in .env.dev.

NAMESPACE=itip
DEPLOY_ENV=preprod
RELEASE=itip-web-backend

CHART=./ops/helm
PORT_FORWARD_PID_FILE=.dev-port-forwards.pids

SERVER_PORT=8080
DB_URL=jdbc:postgresql://localhost:5432/itip_web_backend
DB_USER=itip_local
SPRING_SECURITY_OAUTH2_RESOURCESERVER_JWT_ISSUER_URI=http://localhost:9000/realms/sie
ITIP_SECURITY_PERMIT_ALL=false
ITIP_SECURITY_JWT_EXPIRATION_MS=3600000
