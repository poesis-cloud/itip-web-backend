# Default environment variables for dev/runtime wiring.
# Non-secret defaults are checked in. Override secrets in .env.dev.

NAMESPACE=itip
DEPLOY_ENV=preprod
RELEASE=itip-web-backend

CHART=./ops/helm
PORT_FORWARD_PID_FILE=.dev-port-forwards.pids

SERVER_PORT=8080
# itip-web-database port-forwards the dev cluster database to 5433
# (5432 is commonly taken by the SIE database port-forward).
DB_URL=jdbc:postgresql://localhost:5433/itip_web_backend
DB_USER=itip_local
ITIP_SECURITY_PERMIT_ALL=false
ITIP_SECURITY_JWT_EXPIRATION_MS=3600000
