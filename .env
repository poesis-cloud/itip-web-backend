# Environment defaults for itip-web-backend
# Non-secret runtime configuration checked into source control.
# Override with .env.dev (local, not committed).

# SIE Definition Manager base URL
# SIE_DM_BASE_URL=http://sie-definition-manager.sie.svc.cluster.local:8080

# OIDC / OAuth2 Resource Server issuer
# OIDC_ISSUER_URI=http://localhost:9000/realms/sie

# OpenTelemetry collector endpoint
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector.monitoring.svc.cluster.local:4317

# Server port
SERVER_PORT=8080
